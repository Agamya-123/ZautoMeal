# Environment Variables — copy to .env and fill in values

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/zautomeal

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ─── Swiggy Builder API (add when received) ──────────────
SWIGGY_API_KEY=your_swiggy_api_key
SWIGGY_API_BASE_URL=https://api.swiggy.com/builder/v1

# ─── Gemini AI ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Notifications ───────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

WHATSAPP_API_KEY=your_whatsapp_api_key

# ─── Payments ────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ─── App ─────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
MCP_PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
